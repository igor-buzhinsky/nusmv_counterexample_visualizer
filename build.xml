<project name="jarsBuilder" default="all">
    <property name="src.dir" value="src"/>
    <property name="bin.dir" value="jar-classes"/>
    <property name="jars.dir" value="jars"/>

    <property name="args4j.path" value="lib/args4j-2.0.21.jar"/>
    <property name="commons.lang3.path" value="lib/commons-lang3-3.1.jar"/>
    <property name="antlr.path" value="lib/antlr-runtime-4.7.1.jar"/>
    
    <property name="main.main" value="nusmv_counterexample_visualizer/ConsoleMain"/>
    <property name="main.jar" value="visualizer-console.jar"/>

    <property name="gui.main" value="nusmv_counterexample_visualizer/GUIMain"/>
    <property name="gui.jar" value="visualizer-gui.jar"/>
    
    <property name="debug" value="true"/>
    
    <target name="all"
            depends="main-jar, gui-jar">
    </target>

    <target name="main-jar">
        <mkdir dir="${bin.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${bin.dir}"
               classpath="${commons.lang3.path}:${args4j.path}:${antlr.path}"
               includeantruntime="false"
               debug="${debug}">
            <include name="${main.main}.java"/>
        </javac>
        <jar destfile="${jars.dir}/${main.jar}"
             basedir="${bin.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.main}"/>
            </manifest>
            <zipfileset src="${commons.lang3.path}" excludes="META-INF/*.SF"/>
            <zipfileset src="${args4j.path}" excludes="meta-inf/*.sf"/>
            <zipfileset src="${antlr.path}" excludes="meta-inf/*.sf"/>
        </jar>
        <delete dir="${bin.dir}"/>
    </target>
    
    <target name="gui-jar">
        <mkdir dir="${bin.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${bin.dir}"
               classpath="${commons.lang3.path}:${args4j.path}:${antlr.path}"
               includeantruntime="false"
               debug="${debug}">
            <include name="${gui.main}.java"/>
        </javac>
        <jar destfile="${jars.dir}/${gui.jar}"
             basedir="${bin.dir}">
            <manifest>
                <attribute name="Main-Class" value="${gui.main}"/>
            </manifest>
            <zipfileset src="${commons.lang3.path}" excludes="META-INF/*.SF"/>
            <zipfileset src="${args4j.path}" excludes="meta-inf/*.sf"/>
            <zipfileset src="${antlr.path}" excludes="meta-inf/*.sf"/>
        </jar>
        <delete dir="${bin.dir}"/>
    </target>

    <!-- Tests: "ant test" runs the suite, "ant update-golden" re-records the snapshot files in test/golden. -->
    <property name="test.dir" value="test"/>
    <property name="build.dir" value="build"/>
    <property name="junit.path" value="lib/test/junit-platform-console-standalone-1.11.4.jar"/>

    <path id="test.classpath">
        <pathelement location="${build.dir}/classes"/>
        <pathelement location="${build.dir}/test-classes"/>
        <pathelement location="${commons.lang3.path}"/>
        <pathelement location="${args4j.path}"/>
        <pathelement location="${antlr.path}"/>
    </path>

    <target name="compile-tests">
        <mkdir dir="${build.dir}/classes"/>
        <mkdir dir="${build.dir}/test-classes"/>
        <javac srcdir="${src.dir}"
               destdir="${build.dir}/classes"
               classpath="${commons.lang3.path}:${args4j.path}:${antlr.path}"
               includeantruntime="false"
               encoding="UTF-8"
               debug="true"/>
        <javac srcdir="${test.dir}"
               destdir="${build.dir}/test-classes"
               classpath="${build.dir}/classes:${commons.lang3.path}:${args4j.path}:${antlr.path}:${junit.path}"
               includeantruntime="false"
               encoding="UTF-8"
               debug="true"/>
    </target>

    <macrodef name="run-junit">
        <attribute name="update" default="false"/>
        <sequential>
            <java jar="${junit.path}" fork="true" failonerror="true" dir="${basedir}">
                <jvmarg value="-Dfile.encoding=UTF-8"/>
                <jvmarg value="-Dgolden.update=@{update}"/>
                <arg value="execute"/>
                <arg value="--disable-banner"/>
                <arg value="--details=tree"/>
                <arg value="--details-theme=ascii"/>
                <arg value="--disable-ansi-colors"/>
                <arg value="--class-path"/>
                <arg pathref="test.classpath"/>
                <arg value="--scan-class-path=${build.dir}/test-classes"/>
                <arg value="--reports-dir=${build.dir}/test-reports"/>
            </java>
        </sequential>
    </macrodef>

    <target name="test" depends="compile-tests">
        <run-junit/>
    </target>

    <target name="update-golden" depends="compile-tests">
        <run-junit update="true"/>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>
</project>
